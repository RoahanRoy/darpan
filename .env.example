# Copy to .env.local and fill in. Server-side only — never prefix with VITE_.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require"

# The site's public origin, no trailing slash. Only used at build time, to
# write dist/sitemap.xml and the Sitemap line in robots.txt — a sitemap has to
# carry absolute URLs, and nothing else in the build knows the domain.
# Unset is fine: the build skips the sitemap and says so.
SITE_URL="https://example.org"
